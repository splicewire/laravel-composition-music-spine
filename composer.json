{
    "name": "splicewire/laravel-composition-music-spine",
    "description": "The shared, satellite-importable surface of the MIDI/music generation seam: the platform-coined MusicIntent wire format (a song-agnostic generation-intent DTO — key, tempo, meter, ordered sections of chords + energy + roles + optional beat-relative melody) and the RenderInvocable contract (render is an invocable over the format, not the kernel RenderContract). The heavy transpose engine + deterministic Arranger stay private; this is the format satellites and the client share without them (ADR-0125).",
    "type": "library",
    "keywords": ["laravel", "composition", "music", "midi", "intent", "schema"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "schemastud/laravel-data-schemas": "*",
        "spatie/laravel-data": "^4.0|^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "spatie/laravel-typescript-transformer": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Composition\\Music\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Composition\\Music\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Splicewire\\Composition\\Music\\MusicDataServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "merge-plugin": {
            "include": ["composer.local.json"]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
